{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mobilys: iniciar PostgreSQL",
      "type": "process",
      "command": "docker",
      "args": ["compose", "up", "-d", "--wait"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Mobilys: preparar recursos",
      "type": "process",
      "command": "mvn",
      "windows": { "command": "mvn.cmd" },
      "args": ["-q", "process-resources"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "dependsOn": "Mobilys: iniciar PostgreSQL",
      "problemMatcher": []
    }
  ]
}
